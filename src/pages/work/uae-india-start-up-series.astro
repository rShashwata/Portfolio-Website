---
// ───────────────────────────────────────────────────────────────────────────
//  BESPOKE CASE STUDY — UAE-India Start-Up Series
//  Hand-built page, deliberately NOT rendered by work/[id].astro. That
//  template skips this slug (see its `bespoke` list) so only this file owns
//  the URL. The project still lives in site.js: it drives the home-page row,
//  the gallery card and the "next project" chain, and the hero meta below is
//  read from it rather than duplicated here.
//
//  ALL PLACEHOLDER COPY IS MARKED  <<PLACEHOLDER>>  — swap it for the real
//  write-up. Asset slots with `src: null` render an accent tile, so nothing
//  breaks while files are still missing.
//
//  The tab behaviour is `initUissTabs()` in src/scripts/main.js, keyed off the
//  data-uiss-tab / data-uiss-panel hooks below. It deliberately does NOT live
//  in a <script> on this page: Astro inlines a small page module straight into
//  the HTML, and the CSP in public/_headers sets `script-src 'self'` with no
//  unsafe-inline — the browser would block it and the tabs would do nothing.
// ───────────────────────────────────────────────────────────────────────────
import Layout from '../../layouts/Layout.astro';
import CaseHead from '../../components/CaseHead.astro';
import { projects, profile, R2 } from '../../data/site.js';

// Every slot is declared nullable so a missing asset renders a placeholder
// instead of a broken tag, and so the arrays below stay one uniform shape.
type Shot = { src: string | null; caption: string };
type Reel = { src: string | null; poster: string | null; label: string; meta: string };
// A UX block renders any combination of these — prose, an arrow list, a card
// grid and a row of image slots — in that order, so every key is optional.
type UxBlock = {
  title: string;
  body?: string[];
  list?: string[];
  cards?: { label: string; text: string }[];
  media?: Shot[];
};

const ID = 'uae-india-start-up-series';
const index = projects.findIndex((p) => p.id === ID);
const project = projects[index];
const next = projects[(index + 1) % projects.length];

// ── EDIT BELOW ────────────────────────────────────────────────────────────

// Page-level lede.
const lede = [
  'The UAE-India Start-Up Series (UISS) is a flagship cross-border start-up platform run under the CEPA framework - a pitch stage where founders from the Indian market meet investors, regulators and embassy leadership in the same room, to get the opportunity to get funding and incubation assistance in the UAE market, to help them scale their brand on a global stage.',
];

// TAB 1 — Event Branding. `src: null` → placeholder tile.
// All six share one paged frame, so this is the order the arrows step through
// — first entry is what the panel opens on.
const brandingShots: Shot[] = [
  {
    src: '/img/work/uae-india-start-up-series/event-area-centre-shot.jpg',
    caption: 'Event area — centre shot',
  },
  {
    src: '/img/work/uae-india-start-up-series/event-id-cards.jpg',
    caption: 'Event ID cards',
  },
  {
    src: '/img/work/uae-india-start-up-series/event-area-angle-shot-1.jpg',
    caption: 'Event area — angle shot 1',
  },
  {
    src: '/img/work/uae-india-start-up-series/event-area-angle-shot-2.jpg',
    caption: 'Event area — angle shot 2',
  },
  {
    src: '/img/work/uae-india-start-up-series/event-branding/speaker-on-stage.webp',
    caption: 'Speaker on stage',
  },
  {
    src: '/img/work/uae-india-start-up-series/event-branding/audience-view.webp',
    caption: 'Audience view',
  },
];

// TAB 3 — Promotional Content. Self-hosted vertical (9:16) clips on R2, one
// per campaign moment rather than one generic "highlights" cut.
// `poster` is optional but worth setting on big files: without one the browser
// shows a black box until metadata arrives. All four are stills grabbed from
// their own clip with headless Chromium (seek + screenshot), at the timestamp
// each frame reads best — a still of a frame that already exists, not a new
// asset.
//
// View counts are confirmed against the two Instagram Insights screenshots in
// `igProof` below, each named for the reel it documents. The other two
// (MoU signing, Top 500 shortlisted) are read off an earlier grid screenshot
// rather than a dedicated Insights shot — <<VERIFY>> marks those two.
const reels: Reel[] = [
  {
    src: `${R2}/UISS_Promo_Videos/Application_Process.mp4`,
    poster: '/img/work/uae-india-start-up-series/promotions/posters/application-process-poster.png',
    label: 'How to apply — application walkthrough',
    meta: '655K views · Instagram Reels',
  },
  {
    src: `${R2}/UISS_Promo_Videos/Start-Up_Question_Interview.mp4`,
    poster: '/img/work/uae-india-start-up-series/promotions/posters/startup-question-poster.png',
    label: 'Street interview — "What comes to mind when you think Start-ups?"',
    meta: '1.4M views · Instagram Reels',
  },
  {
    src: `${R2}/UISS_Promo_Videos/MoU_Signing_Masters'_Union_Gurugram.mp4`,
    poster: '/img/work/uae-india-start-up-series/promotions/posters/mou-signing-poster.png',
    label: "MoU signing — Masters' Union, Gurugram",
    meta: '23.3K views · Instagram Reels', // <<VERIFY — matched to the handshake grid tile>>
  },
  {
    src: `${R2}/UISS_Promo_Videos/Top_500_Shortlisted.mp4`,
    poster: '/img/work/uae-india-start-up-series/promotions/posters/top-500-poster.png',
    label: 'Top 500 shortlisted — milestone announcement',
    meta: '<<PLACEHOLDER — view count not visible in the grid screenshots>> · Instagram Reels',
  },
];

// Two Instagram Insights screenshots — the receipts for two of the view
// counts above, shown after the reels so the claim follows the proof.
type ProofShot = { src: string | null; caption: string; metric: string };
const igProof: ProofShot[] = [
  {
    src: '/img/work/uae-india-start-up-series/promotions/application-process-viewership.png',
    caption: '"How to apply" reel — Instagram Insights',
    metric: '655K views',
  },
  {
    src: '/img/work/uae-india-start-up-series/promotions/startup-question-reel-viewership.png',
    caption: 'Street-interview reel — Instagram Insights',
    metric: '1.4M views',
  },
];

// Headline stats for the campaign — sit beside the intro copy, in the column
// space its 62ch measure leaves open, so the reach is stated once, plainly,
// right next to the write-up rather than as a separate row beneath it.
const promoStats: { label: string; text: string }[] = [
  {
    label: '10,000+ applications',
    text: 'Received in a single application cycle, direct from the reach these reels built — not the Council’s existing mailing list.',
  },
  {
    label: '1.5M peak views',
    text: 'On the highest-performing single reel, organic — no paid media behind the campaign.',
  },
];

// ── TAB 2 — UI Design ─────────────────────────────────────────────────────
//  Structured as a standard UX case study. Every image slot below is `src:
//  null` for now and renders a labelled placeholder at the right aspect ratio,
//  so the layout is already correct — dropping a screenshot in is a one-line
//  change per slot. Keep screens in /public/img/work/uae-india-start-up-series/.

// Lead screen, shown full width at 16:9. <<PLACEHOLDER>>
const uiLeadScreen: Shot = {
  src: null,
  caption: 'Programme landing page — desktop',
};

// Supporting screens, shown as a row of phone-ratio (9:16) slots.
// <<PLACEHOLDER>>
const uiScreens: Shot[] = [
  { src: null, caption: 'Application — eligibility step' },
  { src: null, caption: 'Application — team and deck upload' },
  { src: null, caption: 'Panel shortlist — live scoring' },
];

// Pull quote: the framework's "bold statement that outlines your research
// conclusion". `lead` renders in the accent colour. <<PLACEHOLDER>>
const uiStatement = {
  lead: 'Founders were not abandoning the form because it was long.',
  rest: 'They abandoned it because they could not see what would be asked next — so the flow was rebuilt around showing the shape of the whole application up front.',
};

const uxBlocks: UxBlock[] = [
  {
    title: 'Project Summary',
    body: [
      'A responsive web platform for the Start-Up Series: a public-facing programme page, a founder application flow and an internal shortlist view used by the selection panel during pitch week.',
      'Designed in Figma as a desktop-first system with a mobile breakpoint, handed to the development vendor as annotated screens plus a component sheet.',
    ],
    media: [
      { src: null, caption: 'Sitemap and screen inventory' }, // <<PLACEHOLDER>>
      { src: null, caption: 'Low-fidelity wireframes' }, // <<PLACEHOLDER>>
    ],
  },
  {
    title: 'Goals',
    cards: [
      {
        label: 'One sitting, one phone',
        text: 'Application completable end to end on a phone, without a login or a desktop.',
      },
      {
        label: 'One screen for the panel',
        text: 'Rank, filter and score applicants live, during the pitch session rather than after it.',
      },
      {
        label: 'Official, not start-up-y',
        text: 'Carry the UISS event identity on screen without losing the institutional tone the Embassy requires.',
      },
    ],
  },
  {
    title: 'Business Impact',
    cards: [
      {
        label: 'Applications collected',
        text: 'Over 10,000 in the first cycle, replacing a mailbox-and-spreadsheet process.',
      },
      {
        label: 'Review time halved',
        text: '<<PLACEHOLDER>> Panel review per applicant, against the previous PDF-circulation method.',
      },
      {
        label: 'Reused every edition',
        text: 'One template the Council now runs each cycle instead of rebuilding per event.',
      },
    ],
  },
  {
    title: 'Research & Approach',
    body: [
      'No budget or calendar for formal user research, so the inputs were what already existed: the previous cycle’s application emails, the secretariat’s own shortlisting spreadsheet, and two walkthroughs with the officers who process submissions.',
      'That surfaced the real bottleneck — founders were sending incomplete decks and staff were chasing them by email — so the flow was built around progressive disclosure and inline validation rather than a longer form.',
      'Reference set was other government-adjacent start-up programmes rather than consumer SaaS: the design had to read as official, not as a launch landing page.',
    ],
    media: [
      { src: null, caption: 'Journey map — founder application path' }, // <<PLACEHOLDER>>
      { src: null, caption: 'Competitor audit — programme sites' }, // <<PLACEHOLDER>>
    ],
  },
  {
    title: 'Technical Limitations',
    body: [
      'Lack of context. I joined after the platform’s scope was already committed and had no access to analytics, no prior user data and no direct line to founders who had applied before. Decisions had to be made from proxy evidence and staff interviews, which is a real limitation on how confidently the flow can be claimed to be optimal.',
      'Time crunch. The screens were needed inside the launch window, in parallel with the event collateral for the same programme. Usability testing was cut, and the design was locked at one round of internal review with a shared component library constraining what could be specified.',
    ],
  },
  {
    title: 'Next Steps',
    list: [
      'Instrument the application flow and measure drop-off per step — the first cycle shipped without analytics.',
      'Moderated testing with five founders from the applicant pool to validate the disclosure order.',
      'An accessibility pass against WCAG AA, focusing on form errors and keyboard order in the panel view.',
      'Extend the component sheet into a documented kit so future editions do not need a designer to launch.',
    ],
  },
];

// UISS 1.0 — launch edition intro copy, alongside the phase title.
const uiss1 = {
  eyebrow: 'Edition 01',
  title: 'UISS 1.0',
  // <<PLACEHOLDER>>
  body: [
    'I designed the visual branding for both editions: the launch event branding for UISS 1.0, the website design for the platform, and the promotional content and social campaign that followed and carried it.',
  ],
};

// UISS 2.0 — live site. The link's rel does three separate jobs:
//   noopener   — the new tab can't reach back into this one (standard).
//   noreferrer — suppresses the Referer header, so a click lands in their
//                analytics as direct traffic with no mention of this domain.
//   nofollow   — asks crawlers not to follow or attribute the link. Google has
//                treated it as a hint rather than a rule since 2019, so it
//                reduces rather than guarantees; the real pre-launch cover is
//                public/robots.txt, which stops the page being crawled at all.
const liveUrl = 'https://startupseries.ae';
const uiss2 = {
  eyebrow: 'Edition 02',
  title: 'UISS 2.0',
  // <<PLACEHOLDER>>
  body: [
    'The second edition rebuilt the identity for a larger programme: a wider colour system, a refreshed logotype lockup and a full web presence rather than a single event page.',
    'The platform is live — the branding, layout and asset system below are in production use.',
  ],
};

// ── Brand guidelines ───────────────────────────────────────────────────────
//  Shown as a paged set of images (initGuidelinesViewer in main.js), not a PDF
//  link — the source files are never published under /public, so there is no
//  URL a visitor could hit to download the document directly; the rendered
//  page images are the only public artefact. Each page was rendered once with
//  tools/pdf-pages.py (not wired into `npm run covers` — that one only ever
//  needs page 1) into /public/img/work/<id>/guidelines-<edition>/page-NN.jpg —
//  re-run it by hand if either deck is ever revised.
type Guidelines = {
  eyebrow: string;
  title: string;
  body: string[];
  pages: string[];
  aspect: string; // CSS aspect-ratio value, matches the source deck's page ratio
};

// ── TAB 1, first segment — the route that didn't ship ─────────────────────
//  Sits above the guidelines block, so the panel reads: the search, then the
//  thing that was found, then what was built with it. Same `Guidelines` shape
//  as the two decks below, and rendered from a PDF the same way — see the type
//  for the tools/pdf-pages.py command.
const process1: Guidelines = {
  eyebrow: 'Process',
  title: 'Finding the mark',
  body: [
    'The brief was one line: keep it simple. The Series puts Indian founders in front of UAE investors and incubators under the CEPA framework, and the identity had to hold on an embassy stage, in a pitch deck and on a phone screen alike.',
    'The first route went the other way entirely. I built it out of the architecture the two countries share — the pointed arch, paisley, Arabic letterforms — over fluted-glass gradients in bronze, indigo and purple. It looked good and said the wrong thing: heritage and hospitality rather than founders and funding. It was also all surface. Every variant needed a full-bleed gradient behind it to work at all, and none of it survived being scaled down to a badge.',
    'What carried forward was the one structural idea underneath the ornament: lines converging on a point. Stripped of everything else, that became the four-arrow mark.',
  ],
  pages: Array.from(
    { length: 7 },
    (_, i) => `/img/work/${ID}/rough-work/page-${String(i + 1).padStart(2, '0')}.jpg`
  ),
  aspect: '16 / 9',
};

const guidelines1: Guidelines = {
  eyebrow: 'Brand guidelines',
  title: 'The launch identity',
  body: [
    'The identity is built from a single mark: four arrows around a shared centre. Three point inward — the programme, its partners and its investors converging on one founder — while the fourth breaks outward in a lighter tint, carrying the start-up up and out. Everything arrives so that one thing can launch.',
  ],
  pages: Array.from(
    { length: 8 },
    (_, i) => `/img/work/${ID}/guidelines-1/page-${String(i + 1).padStart(2, '0')}.jpg`
  ),
  aspect: '1600 / 619',
};

const guidelines2: Guidelines = {
  eyebrow: 'Brand guidelines',
  title: '2.0 rulebook',
  body: [
    'A working rulebook for the identity of the upcoming UISS 2.0 — logo and clear space, colour and gradients, type, and rules for co-branding, social and web.',
  ],
  pages: Array.from(
    { length: 12 },
    (_, i) => `/img/work/${ID}/guidelines-2/page-${String(i + 1).padStart(2, '0')}.jpg`
  ),
  aspect: '16 / 9',
};

// Paging arrows for the three image viewers on this page. SVG rather than the
// ‹ › characters those buttons used to hold: a glyph is positioned by its font
// metrics, not by its ink, so `place-items: center` was centring the em box
// while the visible arrow sat high and slightly off to one side inside it. Each
// path's bounding box is 9→15 on a 24 viewBox, i.e. centred by construction, so
// the arrow lands on the circle's centre in any font at any size.
const arrow = (d: string) =>
  `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;
const ARROW_PREV = arrow('M15 5 9 12l6 7');
const ARROW_NEXT = arrow('M9 5l6 7-6 7');

const tabs = [
  { key: 'branding', label: 'Branding' },
  { key: 'ui', label: 'UI Design' },
  { key: 'content', label: 'Promotions' },
];

const metaDescription =
  'Brand identity, event collateral, promotional film and platform UI for the UAE-India Start-Up Series, across both editions of the programme.';
---

<Layout title={`${project.title} — ${profile.name}`} description={metaDescription}>
  <CaseHead />

  <main class="uiss" style={`--a:${project.accent}`}>
    <!-- ── Hero: full-bleed cover, meta overlaid ───────────────────────── -->
    <section class="hero-uiss">
      {
        project.media ? (
          <img class="hero-uiss__img" src={project.media} alt="" fetchpriority="high" />
        ) : null
      }
      <div class="hero-uiss__inner">
        <div class="wrap">
          <p class="hero-uiss__eyebrow" data-reveal>{project.category}</p>
          <h1 class="display hero-uiss__title" data-reveal>{project.title}</h1>
          <ul class="hero-uiss__meta">
            <li data-reveal><span class="hero-uiss__k">Client</span>{project.client}</li>
            <li data-reveal><span class="hero-uiss__k">Year</span>{project.year}</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ── Lede ────────────────────────────────────────────────────────── -->
    <section class="section uiss__lede">
      <div class="wrap uiss__lede-grid">
        <h2 class="display uiss__lede-title" data-reveal>Overview</h2>
        <div class="uiss__lede-copy">
          {lede.map((para) => <p data-reveal>{para}</p>)}
        </div>
      </div>
    </section>

    <!-- ── UISS 1.0: base image + tabbed panels ────────────────────────── -->
    <section class="section uiss__phase" id="uiss-1">
      <div class="wrap">
        <div class="uiss__phase-grid">
          <header class="uiss__phase-head">
            <p class="eyebrow" data-reveal>{uiss1.eyebrow}</p>
            <h2 class="display uiss__phase-title" data-reveal>{uiss1.title}</h2>
          </header>
          <div class="uiss__phase-copy">
            {uiss1.body.map((para) => <p data-reveal>{para}</p>)}
          </div>
        </div>

        <!-- Tab bar sticks under the header for the length of this section.
             Buttons, not links, so no hash lands in the URL — a fragment
             triggers the pre-paint jump handling in theme-init.js, which
             can't resolve a panel that starts collapsed.
             The plate and the tablist are separate elements: the sliding fill
             is a child of the plate, and role="tablist" may only contain tabs. -->
        <div class="uiss__tabs" data-uiss-tabs>
          {/* The active tab's fill, moved by main.js. Decorative — the state it
              shows is already announced by aria-selected on the buttons. */}
          <span class="uiss__tab-pill" aria-hidden="true" data-uiss-pill></span>
          <div class="uiss__tablist" role="tablist" aria-label="UISS 1.0 workstreams">
            {
              tabs.map((t, i) => (
                <button
                  class:list={['uiss__tab', { 'is-active': i === 0 }]}
                  type="button"
                  role="tab"
                  id={`uiss-tab-${t.key}`}
                  aria-controls={`uiss-panel-${t.key}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  data-uiss-tab={t.key}
                >
                  {t.label}
                </button>
              ))
            }
          </div>
        </div>

        <!-- Panels are collapsed by CSS gated on `html.js` (set before paint in
             theme-init.js), so there's no flash of all three on load and a
             no-JS visitor still gets every panel stacked and readable.
             Nothing inside a panel carries `data-reveal`: those start at
             opacity 0 and their ScrollTrigger is registered against a
             display:none element, so the content could never fade in. -->
        <div class="uiss__panels" data-uiss-panels>
          <!-- Event Branding -->
          <section
            class="uiss__panel is-active"
            id="uiss-panel-branding"
            role="tabpanel"
            aria-labelledby="uiss-tab-branding"
            data-uiss-panel="branding"
            tabindex="0"
          >
            <!-- Process — the route that didn't ship. Same text-left /
                 frame-right shape and the same paged deck viewer as the
                 guidelines block below it; these are rendered slides, so the
                 frame carries their 16:9 ratio and nothing is cropped. -->
            <div class="uiss__guides" data-reveal>
              <div class="uiss__guides-head">
                <div class="uiss__guides-text">
                  <p class="eyebrow">{process1.eyebrow}</p>
                  <h3 class="display uiss__guides-title">{process1.title}</h3>
                  <div class="uiss__guides-copy">
                    {process1.body.map((para) => <p>{para}</p>)}
                  </div>
                </div>

                <figure
                  class="uiss__guide-viewer"
                  data-guide-viewer
                  data-guide-protect
                  style={`--ar:${process1.aspect}`}
                >
                  <div class="uiss__guide-frame">
                    {
                      process1.pages.map((src, i) => (
                        <img
                          class:list={['uiss__guide-page', { 'is-active': i === 0 }]}
                          data-guide-page
                          src={src}
                          alt={`${process1.title} — rough work, page ${i + 1} of ${process1.pages.length}`}
                          loading={i === 0 ? 'eager' : 'lazy'}
                        />
                      ))
                    }
                  </div>
                  <div class="uiss__guide-controls">
                    <button
                      type="button"
                      class="uiss__guide-btn"
                      data-guide-prev
                      aria-label="Previous page"
                      disabled
                      set:html={ARROW_PREV}
                    />
                    <span class="uiss__guide-count" data-guide-count>{`1 / ${process1.pages.length}`}</span>
                    <button
                      type="button"
                      class="uiss__guide-btn"
                      data-guide-next
                      aria-label="Next page"
                      set:html={ARROW_NEXT}
                    />
                  </div>
                </figure>
              </div>
            </div>

            <!-- Brand guidelines — paged image viewer, no PDF link. See the
                 `Guidelines` type above for why. Lives inside this panel rather
                 than above the tab bar, so it's under "Branding" specifically
                 instead of always visible regardless of tab. -->
            <div class="uiss__guides" data-reveal>
              <div class="uiss__guides-head">
                <div class="uiss__guides-text">
                  <p class="eyebrow">{guidelines1.eyebrow}</p>
                  <h3 class="display uiss__guides-title">{guidelines1.title}</h3>
                  <div class="uiss__guides-copy">
                    {guidelines1.body.map((para) => <p>{para}</p>)}
                  </div>
                </div>

                <figure
                  class="uiss__guide-viewer"
                  data-guide-viewer
                  data-guide-protect
                  style={`--ar:${guidelines1.aspect}`}
                >
                  <div class="uiss__guide-frame">
                    {
                      guidelines1.pages.map((src, i) => (
                        <img
                          class:list={['uiss__guide-page', { 'is-active': i === 0 }]}
                          data-guide-page
                          src={src}
                          alt={`${guidelines1.title} — page ${i + 1} of ${guidelines1.pages.length}`}
                          loading={i === 0 ? 'eager' : 'lazy'}
                        />
                      ))
                    }
                  </div>
                  <div class="uiss__guide-controls">
                    <button
                      type="button"
                      class="uiss__guide-btn"
                      data-guide-prev
                      aria-label="Previous page"
                      disabled
                      set:html={ARROW_PREV}
                    />
                    <span class="uiss__guide-count" data-guide-count>{`1 / ${guidelines1.pages.length}`}</span>
                    <button
                      type="button"
                      class="uiss__guide-btn"
                      data-guide-next
                      aria-label="Next page"
                      set:html={ARROW_NEXT}
                    />
                  </div>
                </figure>
              </div>
            </div>

            <!-- Copy left, one paged photo frame right — the page's shared
                 grid, so this row lines up with the guidelines block above it.
                 The frame runs on the same `data-guide-*` viewer as the two
                 brand decks; it just isn't marked `data-guide-protect`, since
                 these are event photos rather than the licensed deck pages. -->
            <div class="uiss__brand-grid">
              <div class="uiss__panel-copy">
                <h3 class="uiss__panel-title display">Event Branding</h3>
                {/* <<PLACEHOLDER>> */}
                <p>
                  The launch event set the template for everything after it: a stage identity,
                  signage system and delegate collateral built for a room holding embassy
                  leadership, ministry officials and founders at the same time.
                </p>
                <p>
                  Most of the work was navigating approvals rather than drawing — every asset
                  carrying the Embassy mark cleared protocol review, so the system was designed to
                  survive changes late: fixed lockup zones, one type hierarchy, colour that held up
                  in print and on an LED wall.
                </p>
                <p>
                  Turnarounds ran in hours, not days. Speaker lists moved the morning of the event,
                  so backdrop and screen assets were built as templates I could re-export on site.
                </p>
              </div>

              <div class="uiss__shot-viewer" data-guide-viewer>
                <div class="uiss__shot-frame">
                  {
                    brandingShots.map((shot, i) => (
                      <figure
                        class:list={['uiss__shot-slide', { 'is-active': i === 0 }]}
                        data-guide-page
                      >
                        {shot.src ? (
                          <img
                            src={shot.src}
                            alt={shot.caption}
                            loading={i === 0 ? 'eager' : 'lazy'}
                          />
                        ) : (
                          <span class="uiss__ph">
                            <span>Image coming soon</span>
                          </span>
                        )}
                        <figcaption class="uiss__shot-cap">{shot.caption}</figcaption>
                      </figure>
                    ))
                  }
                </div>
                <div class="uiss__guide-controls">
                  <button
                    type="button"
                    class="uiss__guide-btn"
                    data-guide-prev
                    aria-label="Previous photo"
                    disabled
                    set:html={ARROW_PREV}
                  />
                  <span class="uiss__guide-count" data-guide-count>{`1 / ${brandingShots.length}`}</span>
                  <button
                    type="button"
                    class="uiss__guide-btn"
                    data-guide-next
                    aria-label="Next photo"
                    set:html={ARROW_NEXT}
                  />
                </div>
              </div>
            </div>
          </section>

          <!-- UI Design -->
          <section
            class="uiss__panel"
            id="uiss-panel-ui"
            role="tabpanel"
            aria-labelledby="uiss-tab-ui"
            data-uiss-panel="ui"
            tabindex="0"
          >
            <div class="uiss__panel-copy">
              <h3 class="uiss__panel-title display">UI Design</h3>
              <p>
                {/* <<PLACEHOLDER>> */}
                The platform side of the programme, written up as a case study — including what the
                constraints made impossible.
              </p>
            </div>

            <!-- Screens. Each slot holds its final aspect ratio while empty, so
                 dropping real screenshots in never reflows the layout. -->
            <figure class="uiss__screen uiss__screen--lead">
              {
                uiLeadScreen.src ? (
                  <img src={uiLeadScreen.src} alt={uiLeadScreen.caption} loading="lazy" />
                ) : (
                  <span class="uiss__ph">
                    <span class="uiss__ph-k">16:9</span>
                    <span>Screen coming soon</span>
                  </span>
                )
              }
              <figcaption>{uiLeadScreen.caption}</figcaption>
            </figure>

            <div class="uiss__screen-row">
              {
                uiScreens.map((screen) => (
                  <figure class="uiss__screen uiss__screen--tall">
                    {screen.src ? (
                      <img src={screen.src} alt={screen.caption} loading="lazy" />
                    ) : (
                      <span class="uiss__ph">
                        <span class="uiss__ph-k">9:16</span>
                        <span>Screen coming soon</span>
                      </span>
                    )}
                    <figcaption>{screen.caption}</figcaption>
                  </figure>
                ))
              }
            </div>

            <blockquote class="uiss__statement">
              <span class="uiss__statement-lead">{uiStatement.lead}</span>
              {uiStatement.rest}
            </blockquote>

            <div class="uiss__ux">
              {
                uxBlocks.map((block) => (
                  <div class="uiss__ux-block">
                    <h4 class="uiss__ux-title">{block.title}</h4>
                    <div class="uiss__ux-body">
                      {block.body?.map((para) => <p>{para}</p>)}
                      {block.list && (
                        <ul class="uiss__ux-list">
                          {block.list.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      )}
                      {block.cards && (
                        <div class="uiss__ux-cards">
                          {block.cards.map((card) => (
                            <div class="uiss__ux-card">
                              <span class="uiss__ux-card-label">{card.label}</span>
                              <p>{card.text}</p>
                            </div>
                          ))}
                        </div>
                      )}
                      {block.media && (
                        <div class="uiss__ux-media">
                          {block.media.map((item) => (
                            <figure class="uiss__ux-figure">
                              {item.src ? (
                                <img src={item.src} alt={item.caption} loading="lazy" />
                              ) : (
                                <span class="uiss__ph">
                                  <span>Image coming soon</span>
                                </span>
                              )}
                              <figcaption>{item.caption}</figcaption>
                            </figure>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                ))
              }
            </div>
          </section>

          <!-- Promotional Content -->
          <section
            class="uiss__panel"
            id="uiss-panel-content"
            role="tabpanel"
            aria-labelledby="uiss-tab-content"
            data-uiss-panel="content"
            tabindex="0"
          >
            <div class="uiss__promo-head">
              <div class="uiss__panel-copy">
                <h3 class="uiss__panel-title display">Promotional Content</h3>
                <p>
                  The campaign was the programme's reach engine, not collateral bolted on after the
                  event. Deadline reminders, the street-interview hook, the MoU signing and the
                  year-end wrap all ran as native vertical Reels — cut for a phone screen first,
                  never resized down from a landscape master.
                </p>
                <p>
                  Shot and assembled from event footage the same week it was captured, graded for a
                  confident institutional look and subtitled throughout, since most of the audience
                  watched with the sound off. The real measure of it: over 10,000 applications in a
                  single cycle, pulled from founders the Council's own mailing list never touched.
                </p>
              </div>

              <div class="uiss__promo-stats">
                {
                  promoStats.map((stat) => (
                    <div class="uiss__ux-card">
                      <span class="uiss__ux-card-label">{stat.label}</span>
                      <p>{stat.text}</p>
                    </div>
                  ))
                }
              </div>
            </div>

            <h4 class="uiss__ux-title uiss__promo-subhead">The Films</h4>
            <div class="uiss__reels">
              {
                reels.map((reel) => (
                  <figure class="uiss__reel">
                    {reel.src ? (
                      // No autoplay: playback stays user-initiated, which also
                      // keeps it clear of prefers-reduced-motion.
                      <video
                        src={reel.src}
                        poster={reel.poster}
                        controls
                        preload="metadata"
                        playsinline
                        aria-label={reel.label}
                      />
                    ) : (
                      <div class="uiss__reel-ph">
                        <span class="uiss__reel-ph-k">9:16</span>
                        <span class="uiss__reel-ph-t">Video coming soon</span>
                      </div>
                    )}
                    <figcaption>
                      <span class="uiss__reel-label">{reel.label}</span>
                      <span>{reel.meta}</span>
                    </figcaption>
                  </figure>
                ))
              }
            </div>

            <h4 class="uiss__ux-title uiss__promo-subhead">The Reach</h4>
            <p class="uiss__promo-note">
              A slice of the Instagram grid from the cycle — individual reels clearing half a
              million to 1.5M views apiece, all organic.
            </p>
            <div class="uiss__proof-grid">
              {
                igProof.map((shot) => (
                  <figure class="uiss__proof-figure">
                    {shot.src ? (
                      <img src={shot.src} alt={shot.caption} loading="lazy" />
                    ) : (
                      <span class="uiss__ph">
                        <span>Screenshot coming soon</span>
                      </span>
                    )}
                    <figcaption>
                      <span class="uiss__proof-metric">{shot.metric}</span>
                      <span>{shot.caption}</span>
                    </figcaption>
                  </figure>
                ))
              }
            </div>
          </section>

        </div>
      </div>
    </section>

    <!-- ── UISS 2.0 ────────────────────────────────────────────────────── -->
    <section class="section uiss2" id="uiss-2">
      <div class="wrap uiss2__grid">
        <div class="uiss2__intro">
          <p class="eyebrow" data-reveal>{uiss2.eyebrow}</p>
          <h2 class="display uiss2__title" data-reveal>{uiss2.title}</h2>
        </div>
        <div class="uiss2__copy">
          {uiss2.body.map((para) => <p data-reveal>{para}</p>)}
          <div class="uiss2__cta-row" data-reveal>
            <a
              class="uiss2__cta magnetic"
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer nofollow"
              data-cursor="Visit"
            >
              <span class="magnetic__inner">Visit the Official Site ↗</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Brand guidelines. Title and write-up stack in one column; the paged
           viewer sits beside them as a second column on desktop, and drops
           below (full width) once the page goes single-column on mobile. -->
      <div class="wrap uiss__guides">
        <div class="uiss__guides-head">
          <div class="uiss__guides-text">
            <p class="eyebrow" data-reveal>{guidelines2.eyebrow}</p>
            <h3 class="display uiss__guides-title" data-reveal>{guidelines2.title}</h3>
            <div class="uiss__guides-copy">
              {guidelines2.body.map((para) => <p data-reveal>{para}</p>)}
            </div>
          </div>

          <figure
            class="uiss__guide-viewer"
            data-reveal
            data-guide-viewer
            data-guide-protect
            style={`--ar:${guidelines2.aspect}`}
          >
            <div class="uiss__guide-frame">
              {
                guidelines2.pages.map((src, i) => (
                  <img
                    class:list={['uiss__guide-page', { 'is-active': i === 0 }]}
                    data-guide-page
                    src={src}
                    alt={`${guidelines2.title} — page ${i + 1} of ${guidelines2.pages.length}`}
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                ))
              }
            </div>
            <div class="uiss__guide-controls">
              <button
                type="button"
                class="uiss__guide-btn"
                data-guide-prev
                aria-label="Previous page"
                disabled
                set:html={ARROW_PREV}
              />
              <span class="uiss__guide-count" data-guide-count>{`1 / ${guidelines2.pages.length}`}</span>
              <button
                type="button"
                class="uiss__guide-btn"
                data-guide-next
                aria-label="Next page"
                set:html={ARROW_NEXT}
              />
            </div>
          </figure>
        </div>
      </div>
    </section>

    <!-- ── Next project ────────────────────────────────────────────────── -->
    <a class="uiss__next" href={`/work/${next.id}`} data-cursor="Next" style={`--a:${next.accent}`}>
      <div class="wrap">
        <span class="eyebrow">Next project</span>
        <span class="display uiss__next-title">{next.title}</span>
        <span class="uiss__next-cat">{next.category} →</span>
      </div>
    </a>
  </main>
</Layout>

<style>
  /* ── Shared header over this page's dark hero ───────────────────────── */
  /* Unlike the templated case studies, this page opens on a full-bleed dark
     photo, so the fixed header sits on artwork instead of on --bg. In light
     mode its ink is near-black and disappears. These are :global() because the
     header is a separate component — the stylesheet still only ships with this
     page, so nothing else is touched. */
  :global(.post-head:not(.is-scrolled)),
  :global(.post-head:not(.is-scrolled) .post-head__brand),
  :global(.post-head:not(.is-scrolled) .post-head__right) {
    color: #f4f0e6;
  }
  /* Once frosted, the bar spends the next screenful over the same dark photo.
     20% of a cream --bg doesn't lighten it enough for near-black text, so in
     light mode the backdrop goes mostly opaque and the theme's own ink works
     over both the hero and the page below. Dark mode is already legible and
     stays exactly as it is elsewhere on the site. */
  :global([data-theme='light'] .post-head.is-scrolled) {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
  }

  /* ── Page tokens ────────────────────────────────────────────────────── */
  /* One place for the values that were previously re-typed per component.
     Two radii and three spacing steps are enough for this page; anything that
     needs a fourth is a sign the layout, not the token, is wrong. */
  .uiss {
    --r: 8px; /* media, cards, containers */
    --pill: 999px; /* buttons, badges, the tab bar */
    --gap: clamp(1rem, 2.5vw, 2rem); /* between media in a grid */
    --gap-tight: clamp(0.8rem, 1.6vw, 1.2rem); /* dense grids: cards */
    --stack: clamp(2rem, 5vh, 3.5rem); /* between blocks inside a section */
    --stack-lg: clamp(3rem, 8vh, 5rem); /* between major blocks */
    /* The page's editorial grid: label/heading left, content right. Used by
       Overview, the UX blocks and both halves of UISS 2.0, so body copy keeps
       one left edge the whole way down. */
    --col: 1fr 1.4fr;
    --col-gap: clamp(1.5rem, 5vw, 5rem);
    /* Where the tab bar parks once it sticks: clear of the fixed header in its
       scrolled state, plus a little air. The header has no fixed height — its
       padding is fluid — so this tracks the same clamp curve rather than
       hard-coding a pixel value. */
    --stick-top: calc(clamp(3.4rem, 5.5vw, 4.4rem) + 0.6rem);
  }

  /* ── Hero ───────────────────────────────────────────────────────────── */
  .hero-uiss {
    position: relative;
    /* Full-bleed: `.wrap` inside handles the max-width, so the image itself
       runs edge to edge under the fixed header. */
    width: 100%;
    /* A full screen, uncapped. `svh` is the viewport at its SMALLEST — mobile
       browser chrome showing — so the hero is never taller than what's on
       screen at first paint. `dvh` would resize as the chrome hides on scroll,
       which reflows the hero mid-scroll; `vh` overshoots on iOS. The plain
       `vh` line is the fallback for browsers without the newer units. */
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: radial-gradient(120% 120% at 25% 15%, var(--a), #000 92%);
  }
  .hero-uiss__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Scrim: the overlay type is fixed light in BOTH themes (it sits on a photo,
     not on --bg), so it needs a guaranteed dark base under it. */
  .hero-uiss::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.92) 0%,
      rgba(0, 0, 0, 0.6) 38%,
      rgba(0, 0, 0, 0.15) 70%,
      rgba(0, 0, 0, 0.35) 100%
    );
  }
  .hero-uiss__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    /* Top padding clears the fixed header if the viewport is short. */
    padding: clamp(7rem, 18vh, 12rem) var(--pad) clamp(2.5rem, 7vh, 5rem);
    color: #f4f0e6;
  }
  .hero-uiss__eyebrow {
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(244, 240, 230, 0.72);
  }
  /* Sized to sit on ONE line for as long as the column can hold it. The vw
     term is what does that: the column is the viewport less 2x --pad, and --pad
     is 5vw through the middle of the range, so 90% of the viewport has to fit
     the 24 glyphs of the title. The cap is the same sum against the widest the
     column ever gets — .wrap stops at --maxw (1600px), so past a 1600px
     viewport the text would keep growing while its container didn't, and wrap.
     Below ~640px the `min` takes over and it wraps, which is intended: one
     line on a phone would mean an unreadably small display face. */
  .hero-uiss__title {
    font-size: clamp(2.4rem, 6.7vw, 6.6rem);
    margin: 0.18em 0 0.5em;
  }
  /* Full column width, to the right margin. It used to stop at the title's
     first line — measured in JS, since a wrapped line's width isn't expressible
     in CSS — which only read as deliberate while the title wrapped. */
  .hero-uiss__meta {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem clamp(2.5rem, 6vw, 5rem);
    width: 100%;
    border-top: 1px solid rgba(244, 240, 230, 0.28);
    padding-top: clamp(1rem, 2.5vh, 1.5rem);
  }
  .hero-uiss__meta li {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: var(--step-0);
  }
  .hero-uiss__k {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(244, 240, 230, 0.66);
  }

  /* ── Lede ───────────────────────────────────────────────────────────── */
  .uiss__lede-grid {
    display: grid;
    grid-template-columns: var(--col);
    gap: var(--col-gap);
  }
  .uiss__lede-title {
    font-size: var(--step-2);
  }
  .uiss__lede-copy {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    font-size: var(--step-1);
    line-height: 1.4;
    max-width: 60ch;
  }

  /* ── Edition 01 ───────────────────────────────────────────────────────── */
  /* A tomato wash off the top-left corner, gone by the time the tab bar starts.
     Painted as the section's own background rather than a positioned ::before,
     which would need a negative z-index to stay behind the copy and would then
     escape this section's stacking context.

     `background-size` caps the band in pixels: the section runs several screens
     tall (the panels live inside it), so a percentage-based gradient would tint
     the whole thing. 560px is the measured distance from the section's top edge
     to the tab bar — the section's own top padding, the intro grid, and the
     grid's --stack margin — rounded up past its widest reading across eleven
     viewports (452px to 529px). Flat rather than a vh clamp: what moves that
     distance is how the intro copy wraps, which tracks viewport *width*, and
     the whole spread is under 80px either way. The radial's own falloff dies
     well before the band edge, so overshooting is invisible, where a short band
     would leave a hard stop above the pill.

     Fading to `transparent` rather than to white, so the same rule reads as
     "fades to white" in light mode and "fades to the dark ground" in dark. */
  .uiss__phase {
    background-image: radial-gradient(
      75% 100% at 0% 0%,
      color-mix(in srgb, #e24131 20%, transparent),
      transparent 70%
    );
    background-repeat: no-repeat;
    background-position: top left;
    background-size: 100% 560px;
    /* The section's closing space is moved INSIDE .uiss__panels — see the rule
       below. It can't sit here or on .wrap, because a sticky element is
       released by its containing block's CONTENT box: padding on either would
       leave the tab bar letting go early, with the last stretch of the section
       scrolling past with no bar on it. */
    padding-bottom: 0;
  }
  /* Same title/copy grid as UISS 2.0's intro — see `--col` in the page tokens. */
  .uiss__phase-grid {
    display: grid;
    grid-template-columns: var(--col);
    gap: var(--col-gap);
    margin-bottom: var(--stack);
  }
  .uiss__phase-head {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .uiss__phase-title {
    font-size: var(--step-2);
  }
  .uiss__phase-copy {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    font-size: var(--step-1);
    line-height: 1.4;
    max-width: 60ch;
  }
  /* Tab bar: frosted pill row, centred in the column. `width: fit-content` +
     `auto` side margins rather than a flex/grid centre — the bar is a sticky
     block, and shrink-to-fit is what keeps the plate hugging the three tabs
     instead of stretching the full width.

     `sticky`, not `relative`: the bar follows the reader down the section so a
     tab can be switched from anywhere inside it. Its containing block is the
     `.wrap` holding the heading and panels, so it releases on its own at the
     bottom of the panels and scrolls away with the section edge — no JS, and
     it can never trespass into Edition 02. */
  .uiss__tabs {
    position: sticky;
    top: var(--stick-top);
    z-index: 5;
    width: fit-content;
    max-width: 100%;
    /* No bottom margin: a sticky element's MARGIN box is what gets clamped to
       the containing block, so any margin here would park the bar that far
       short of Edition 02's border. The gap below the bar is .uiss__panels'
       padding-top instead — same pixels, on the other side of the boundary. */
    margin: 0 auto;
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--pill);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
  }
  .uiss__tablist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  /* The active tab's fill, as one element that slides between tabs instead of
     a background fading out on one button and in on another. Left unpositioned
     and transparent until main.js measures a target, so it can't flash at 0,0
     — and if the bundle never runs, the static `.is-active` fill below stands
     in (the `.has-pill` class that suppresses it is set by main.js too). */
  .uiss__tab-pill {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    border-radius: var(--pill);
    background: var(--accent);
    opacity: 0;
    pointer-events: none;
  }
  .uiss__tab {
    /* Above the sliding fill, which is painted at z-index 0 behind the row. */
    position: relative;
    z-index: 1;
    /* 48px min target: finger-friendly without a media query. */
    min-height: 48px;
    padding: 0.7rem 1.4rem;
    border-radius: var(--pill);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-dim);
    touch-action: manipulation;
    transition: background 0.4s var(--ease), color 0.4s var(--ease);
  }
  .uiss__tab:hover {
    color: var(--fg);
  }
  /* White, not black: --accent is a deep red in both themes, so the label is
     reading on red here rather than on the lime the token was named for. */
  .uiss__tab.is-active {
    background: var(--accent);
    color: #fff;
  }
  /* Once the pill is live it owns the fill — leaving the button's own
     background on would paint the destination before the slide arrived. */
  .uiss__tabs.has-pill .uiss__tab.is-active {
    background: transparent;
  }
  /* Keyboard focus must stay visible — the custom cursor hides the OS one. */
  .uiss__tab:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 2px;
  }

  /* Carries the spacing on both sides of the panel stack: the gap under the tab
     bar, and the section's closing space. Both are padding on this element
     rather than margins on its neighbours because it is the sticky bar's
     last sibling — the bar is clamped to the content box of .wrap, so this
     element's border box is what decides where the bar lets go. Padding here
     is inside that box and extends the stick; a margin here, or padding on
     .wrap or the section, sits outside it and doesn't. */
  .uiss__panels {
    padding-top: var(--stack);
    padding-bottom: clamp(5rem, 12vh, 11rem);
  }

  /* Panels. Collapsed only when JS is running, so no-JS gets all three. */
  html.js .uiss__panel {
    display: none;
  }
  html.js .uiss__panel.is-active {
    display: block;
    animation: uiss-panel-in 0.5s var(--ease) both;
  }
  /* Without JS the panels stack, so they need separating. */
  html:not(.js) .uiss__panel + .uiss__panel {
    margin-top: var(--stack-lg);
    padding-top: var(--stack-lg);
    border-top: 1px solid var(--line);
  }
  @keyframes uiss-panel-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .uiss__panel:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 6px;
  }
  .uiss__panel-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 62ch;
  }
  .uiss__panel-title {
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }

  /* ── Shared media slots ─────────────────────────────────────────────── */
  /* `contain`, never `cover`. Cover was cropping the sides off the event
     photography and squeezing the wide web banner; letting each image run at
     its natural ratio instead fixed the cropping but left the grids ragged,
     with captions at different heights. So the slot keeps its ratio and the
     image sits inside it whole, on a quiet plate that fills the remainder. */
  .uiss__screen img,
  .uiss__ux-figure img {
    width: 100%;
    border-radius: var(--r);
    object-fit: contain;
    background: var(--bg-soft);
  }
  /* Empty slot. Holds the footprint the image will take, so the layout reads
     correctly while the files are still missing. */
  .uiss__ph {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 1rem;
    border-radius: var(--r);
    /* Deliberately quiet — a dashed outline reads as "slot awaiting a file".
       An accent-filled tile competes with the real screenshots around it, and
       there are enough of these on the page to swamp it. */
    background: var(--bg-soft);
    border: 1px dashed var(--line);
    color: var(--fg-dim);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-align: center;
  }
  .uiss__ph-k {
    padding: 0.25em 0.7em;
    border: 1px solid currentColor;
    border-radius: var(--pill);
    opacity: 0.8;
  }

  /* Event Branding: copy left, one paged photo frame right, on the page's
     shared grid so the row lines up with the guidelines block above it.
     Ruled off from the Launch Identity block above with the same hairline the
     home-page work rows and the UX blocks below use — `.uiss__guides` already
     carries --stack-lg beneath it, so the line sits centred in its own air. */
  .uiss__brand-grid {
    padding-top: var(--stack-lg);
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: var(--col);
    align-items: start;
    gap: var(--col-gap);
  }
  /* Only relevant without JS, where all four slides stack instead of paging. */
  .uiss__shot-frame {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .uiss__shot-slide {
    position: relative;
  }
  /* One fixed box for all four, so the frame doesn't resize as the arrows step
     through. `cover` here rather than the `contain` the other media slots use:
     every branding photo is exactly 3:2, so a 3:2 frame crops nothing, and the
     overlaid caption needs a box that's actually filled to sit on. */
  .uiss__shot-slide :is(img, .uiss__ph) {
    width: 100%;
    aspect-ratio: 3 / 2;
    border-radius: var(--r);
    object-fit: cover;
    background: var(--bg-soft);
  }
  /* Caption over the photo, not under it — otherwise a one- or two-line caption
     changes the height of the whole frame between slides. Light ink on its own
     scrim, fixed in both themes: it sits on a photo, not on --bg. */
  .uiss__shot-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2.4rem 1rem 0.9rem;
    border-radius: 0 0 var(--r) var(--r);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.78), transparent);
    color: #f4f0e6;
    font-size: var(--step--1);
  }

  /* Promotional Content: vertical 9:16 players, height-capped. Both dimensions
     are stated rather than left to aspect-ratio, which would resolve against
     the column width and overflow on wide viewports. */
  /* One caption treatment for every media type on the page. */
  .uiss__screen figcaption,
  .uiss__ux-figure figcaption,
  .uiss__reel figcaption {
    font-size: var(--step--1);
    color: var(--fg-dim);
  }

  .uiss__reels {
    --reel-h: min(70vh, 620px);
    margin-top: var(--stack);
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
  }
  .uiss__reel {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    width: min(100%, calc(var(--reel-h) * 9 / 16));
  }
  .uiss__reel video,
  .uiss__reel-ph {
    width: 100%;
    height: var(--reel-h);
    border-radius: var(--r);
    background: #000;
    /* contain, so a clip whose ratio isn't exactly 9:16 is letterboxed rather
       than cropped. */
    object-fit: contain;
  }
  /* Same quiet treatment as the image slots — see .uiss__ph. */
  .uiss__reel-ph {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.5rem;
    background: var(--bg-soft);
    border: 1px dashed var(--line);
    color: var(--fg-dim);
    text-align: center;
  }
  .uiss__reel-ph-k {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    padding: 0.25em 0.7em;
    border: 1px solid currentColor;
    border-radius: var(--pill);
    opacity: 0.8;
  }
  .uiss__reel-ph-t {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .uiss__reel figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  /* Two lines, but the same size and family as every other caption — the
     display face here made the reels shout over the identically-ranked
     captions in the other panels. */
  .uiss__reel-label {
    font-weight: 500;
    color: var(--fg);
  }

  /* Intro copy + stat cards on the page's shared grid — text left, capped at
     62ch, with the two cards stacked in the column space that measure leaves
     open on the right instead of sitting as a separate full-width row. */
  .uiss__promo-head {
    display: grid;
    grid-template-columns: var(--col);
    align-items: start;
    gap: var(--col-gap);
  }
  /* Stat cards reuse the UI-tab's card/label styling (`.uiss__ux-card`)
     directly rather than a parallel set of rules — same visual language, one
     panel over from where it's defined. Stacked, not the UI tab's auto-fit
     row: two cards side by side here would each be too narrow against a
     1.4fr column to read comfortably. */
  .uiss__promo-stats {
    display: flex;
    flex-direction: column;
    gap: var(--gap-tight);
  }
  .uiss__promo-subhead {
    margin-top: var(--stack);
    margin-bottom: 0.8rem;
  }
  .uiss__promo-note {
    margin-bottom: 1rem;
    max-width: 62ch;
    color: var(--fg-dim);
  }

  /* "The Reach": the two Instagram-grid screenshots. Square, not the reels'
     9:16 — these are Insights captures of the grid itself, cropped 1:1. */
  .uiss__proof-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    align-items: start;
    gap: var(--gap);
  }
  .uiss__proof-figure {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .uiss__proof-figure :is(img, .uiss__ph) {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--r);
    object-fit: contain;
    background: var(--bg-soft);
    border: 1px solid var(--line);
  }
  .uiss__proof-figure figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: var(--step--1);
    color: var(--fg-dim);
  }
  .uiss__proof-metric {
    font-weight: 700;
    font-size: var(--step-0);
    color: var(--accent-ink);
  }

  /* ── UI Design ──────────────────────────────────────────────────────── */
  /* Screens: one wide lead shot, then a row of phone-ratio slots. */
  .uiss__screen {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .uiss__screen--lead {
    margin-top: var(--stack);
  }
  /* Height-capped while empty: at full width a 16:9 slot is ~675px of dashed
     nothing and the panel opens on a void. The cap only applies to the
     placeholder — a real screenshot arrives at its own ratio. */
  .uiss__screen--lead :is(img, .uiss__ph) {
    aspect-ratio: 16 / 9;
  }
  .uiss__screen--lead .uiss__ph {
    max-height: min(52vh, 460px);
  }
  /* Column width is capped rather than fluid: three 9:16 slots across a 1600px
     row would each compute well over a screen tall. Left-aligned, like every
     other block on the page. */
  .uiss__screen-row {
    margin-top: var(--gap);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 240px));
    justify-content: start;
    align-items: start;
    gap: var(--gap);
  }
  .uiss__screen--tall :is(img, .uiss__ph) {
    aspect-ratio: 9 / 16;
  }

  /* Pull quote — the research conclusion, stated once and loudly. */
  .uiss__statement {
    margin: clamp(2.5rem, 7vh, 4.5rem) 0 clamp(1rem, 3vh, 2rem);
    max-width: 40ch;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    font-size: clamp(1.15rem, 2.2vw, 1.9rem);
  }
  .uiss__statement-lead {
    color: var(--accent-ink);
  }

  /* Label / content rows — on the page's shared grid, so this content column
     starts at the same left edge as the Overview and UISS 2.0 copy. */
  .uiss__ux {
    margin-top: var(--stack);
  }
  .uiss__ux-block {
    display: grid;
    grid-template-columns: var(--col);
    gap: var(--col-gap);
    padding: clamp(1.4rem, 3.5vh, 2.2rem) 0;
    border-top: 1px solid var(--line);
  }
  .uiss__ux-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent-ink);
  }
  .uiss__ux-body {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  /* Prose keeps a readable measure; card grids and image rows take the whole
     column, which is why the cap sits here and not on the flex parent. */
  .uiss__ux-body > p,
  .uiss__ux-list {
    max-width: 62ch;
  }
  .uiss__ux-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .uiss__ux-list li {
    padding-left: 1.4rem;
    position: relative;
    color: var(--fg-dim);
  }
  .uiss__ux-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent-ink);
  }

  /* Card grid — used where a block is a set of discrete points (goals,
     impact) rather than continuous prose. */
  .uiss__ux-cards {
    display: grid;
    /* Wraps to two-up before the third card gets too narrow to read — the
       content column is 58% of the grid, not the full width. */
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--gap-tight);
  }
  .uiss__ux-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1rem, 2vw, 1.4rem);
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--bg-soft);
  }
  /* Body face, not the display face: the block label to its left is already
     display/uppercase/accent, and two 700-weight display labels in one row
     read as competing headings rather than a structure and its content. */
  .uiss__ux-card-label {
    font-weight: 700;
    font-size: var(--step-0);
    line-height: 1.2;
  }
  .uiss__ux-card p {
    font-size: var(--step--1);
    color: var(--fg-dim);
  }

  /* Image slots attached to a block (wireframes, journey maps, audits). */
  .uiss__ux-media {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    align-items: start;
    gap: var(--gap);
  }
  .uiss__ux-figure {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .uiss__ux-figure :is(img, .uiss__ph) {
    aspect-ratio: 4 / 3;
  }

  /* ── Edition 02 ───────────────────────────────────────────────────────── */
  /* The mirror of Edition 01's opener: same corner, same geometry, same band
     height — the 2.0 identity's blue where 1.0 gets tomato. Deliberately NOT
     var(--a): the project accent is violet, and as a glow it tinted the whole
     top of the section and put the CTA on a purple ground.
     The ground is now plain --bg rather than --bg-soft, so the wash fades to
     white in light mode; the border-top above still marks where the section
     starts. Band capped in pixels for the same reason as Edition 01 — the
     section is several screens tall, so a percentage would tint all of it. */
  .uiss2 {
    border-top: 1px solid var(--line);
    background-image: radial-gradient(
      75% 100% at 0% 0%,
      color-mix(in srgb, #265eff 20%, transparent),
      transparent 70%
    );
    background-repeat: no-repeat;
    background-position: top left;
    background-size: 100% 560px;
  }
  .uiss2__grid {
    display: grid;
    grid-template-columns: var(--col);
    gap: var(--col-gap);
    /* Space before the guidelines block below. Carried here rather than as
       `.uiss__guides`'s own top margin, since that class is also used as the
       first child inside a UISS 1.0 tab panel, where a top margin would
       collapse straight through the panel and misplace the gap. */
    margin-bottom: var(--stack-lg);
  }
  .uiss2__title {
    font-size: var(--step-2);
    margin-top: 0.3em;
  }
  .uiss2__copy {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    font-size: var(--step-1);
    line-height: 1.4;
    max-width: 60ch;
  }
  .uiss2__cta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: var(--gap-tight);
  }
  .uiss2__cta {
    display: inline-block;
    min-height: 48px;
    border: 1px solid var(--accent);
    border-radius: var(--pill);
    padding: 0.9rem 1.6rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--step--1);
    overflow: hidden;
    touch-action: manipulation;
    transition: background 0.4s var(--ease), color 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  /* The one action this section asks for, so it is filled. Elsewhere on the
     site the pill starts outlined and fills on hover; that read is inverted
     here so the button carries weight against the copy beside it. */
  .uiss2__cta {
    background: var(--accent);
    color: #fff;
  }
  .uiss2__cta:hover {
    background: transparent;
    color: var(--fg);
    border-color: var(--fg);
  }
  .uiss2__cta:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 3px;
  }

  /* The text-left / frame-right segment block. Used three times: the Process
     and Brand guidelines segments inside the "Branding" tab panel, and the
     guidelines block in UISS 2.0. No top margin on the first one, or it'd
     collapse straight through the panel and misplace the gap above the tab bar
     instead. Head on the shared grid; the viewer breaks out wide. */
  .uiss__guides {
    margin-bottom: var(--stack-lg);
  }
  /* Divider between consecutive segments — the same hairline the Event Branding
     block below and the home-page work rows use. Adjacent-sibling, so only the
     second segment onward is ruled, and UISS 2.0's lone block is untouched. */
  .uiss__guides + .uiss__guides {
    padding-top: var(--stack-lg);
    border-top: 1px solid var(--line);
  }
  /* The page's shared grid, so the text column matches the 62ch measure its
     copy is capped at and the viewer takes the wider 1.4fr share — a fixed,
     narrower column left a large dead gap between the two, because the text
     never grew to fill 1fr. `align-items: start` keeps the viewer level with
     the title instead of stretching to the copy's height. */
  .uiss__guides-head {
    display: grid;
    grid-template-columns: var(--col);
    align-items: start;
    gap: var(--col-gap);
  }
  .uiss__guides-title {
    font-size: var(--step-1);
    margin-top: 0.3em;
  }
  .uiss__guides-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
    max-width: 62ch;
    color: var(--fg-dim);
  }
  /* Optically levelled with the eyebrow beside it, not box-levelled. The grid
     already starts both columns on the same line (align-items: start), but the
     eyebrow's first 5px are invisible — half its leading ((1.5em - 1em) / 2 =
     0.25em) plus the gap from the em box to the cap line (~0.08em) — so a frame
     whose edge is real ink read as sitting high. 0.33em of --step--1 is that
     measured 5px, written against the eyebrow's own token so it keeps up as the
     type scales. The mobile query overrides this with the full stack gap, where
     the viewer drops below the write-up instead of sitting beside it. */
  .uiss__guide-viewer {
    margin-top: calc(var(--step--1) * 0.33);
  }
  /* One page visible at a time (JS), or all of them stacked (no-JS — see the
     `html.js` rule below). Each page reserves its own box via `--ar`, matching
     the source deck's ratio, so nothing jumps as images load in. */
  .uiss__guide-frame {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .uiss__guide-page {
    width: 100%;
    aspect-ratio: var(--ar);
    border-radius: var(--r);
    object-fit: cover;
    background: var(--bg-soft);
    /* Most deck pages are white slides — without an edge they merge straight
       into the page's own white background in light mode. */
    border: 1px solid var(--line);
    /* Backs up the contextmenu/dragstart prevention in main.js — no native
       drag-ghost or text-selection cursor to invite a drag-to-desktop save.
       A deterrent only: still screenshottable, like any rendered pixel. */
    -webkit-user-drag: none;
    user-select: none;
  }
  /* Keyed off the attribute, not the class, so both viewers this page runs —
     the brand decks and the branding photo carousel — page with one rule. */
  html.js [data-guide-page]:not(.is-active) {
    display: none;
  }
  /* Prev / next / page count, centred under the frame. */
  .uiss__guide-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }
  .uiss__guide-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--fg);
    touch-action: manipulation;
    transition: background 0.3s var(--ease), color 0.3s var(--ease),
      border-color 0.3s var(--ease), opacity 0.3s var(--ease);
  }
  .uiss__guide-btn:hover:not(:disabled) {
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
  }
  /* `block` so the svg isn't sitting on a text baseline inside the grid cell —
     an inline replaced element reserves descender space below itself, which is
     what pushed the old glyph off the circle's centre. */
  .uiss__guide-btn svg {
    display: block;
  }
  .uiss__guide-btn:disabled {
    opacity: 0.35;
    pointer-events: none;
  }
  .uiss__guide-btn:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 2px;
  }
  .uiss__guide-count {
    min-width: 4.5ch;
    text-align: center;
    font-size: var(--step--1);
    color: var(--fg-dim);
  }
  /* No-JS: buttons are inert (no click handler exists), so hide them rather
     than show controls that do nothing. */
  html:not(.js) .uiss__guide-controls {
    display: none;
  }

  /* ── Next project ───────────────────────────────────────────────────── */
  .uiss__next {
    display: block;
    border-top: 1px solid var(--line);
    padding: clamp(3rem, 10vh, 7rem) 0;
    background: var(--bg-soft);
    transition: background 0.5s var(--ease);
  }
  .uiss__next:hover {
    background: var(--a);
  }
  /* Inset, because the band runs the full width of the viewport. */
  .uiss__next:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: -6px;
  }
  .uiss__next .wrap {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-inline: var(--pad);
  }
  .uiss__next-title {
    font-size: var(--step-2);
    transition: color 0.4s var(--ease);
  }
  .uiss__next:hover .uiss__next-title,
  .uiss__next:hover .eyebrow,
  .uiss__next:hover .uiss__next-cat {
    color: #000;
  }
  .uiss__next-cat {
    font-size: var(--step-0);
    color: var(--fg-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 820px) {
    /* One column below this width — the shared grid collapses everywhere at
       once, so the stacked order stays consistent section to section. */
    .uiss__lede-grid,
    .uiss2__grid,
    .uiss__phase-grid,
    .uiss__guides-head,
    .uiss__brand-grid,
    .uiss__promo-head,
    .uiss__ux-block {
      grid-template-columns: 1fr;
    }
    .uiss__lede-grid,
    .uiss2__grid,
    .uiss__phase-grid,
    .uiss__guides-head,
    .uiss__brand-grid,
    .uiss__promo-head {
      gap: 1.2rem;
    }
    .uiss__ux-block {
      gap: 0.8rem;
    }
    /* Replaces the desktop optical nudge — collapsed to one column, the viewer
       is back below the write-up rather than beside the title. */
    .uiss__guide-viewer {
      margin-top: var(--stack);
    }
    /* Scroller rather than a wrapping row — a pill row wrapping to two lines
       would hold ~17% of a phone viewport the whole way down, since the bar is
       sticky for the length of the section. The scroll container is this
       element, not the tablist, so the pill — absolutely positioned against it
       — travels with the tabs and stays under the active one without a scroll
       handler.

       No `width: 100%` here: the base rule's `fit-content` + `max-width: 100%`
       is what makes this behave at every width. A scroll container's
       min-content is 0, so fit-content resolves to the tabs' own width while
       they fit — a stretched plate with the tabs huddled at one end, which is
       what a flat 100% gave between roughly 700 and 820px — and clamps to the
       column only once they genuinely overflow, which is when scrolling is
       wanted. */
    .uiss__tabs {
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      /* The cut-off third tab is the affordance; a bar this short doesn't need
         a scrollbar drawn over it as well. */
      scrollbar-width: none;
    }
    .uiss__tabs::-webkit-scrollbar {
      display: none;
    }
    .uiss__tablist {
      flex-wrap: nowrap;
      /* Sized to its content so the tabs overflow the plate instead of being
         squeezed into it. The plate's own padding-right is dropped at the end
         of a scroll container, so the trailing air is re-added here. */
      width: max-content;
      padding-right: 0.5rem;
      /* Extra room between switches — shorter labels ("Branding" vs "Event
         Branding") leave more bare pill behind each button, and the desktop
         gap read as cramped against that much empty space. */
      gap: 0.9rem;
    }
    .uiss__tab {
      flex: 0 0 auto;
      padding-inline: 1rem;
    }
    .uiss__reels {
      --reel-h: min(64vh, 520px);
    }
