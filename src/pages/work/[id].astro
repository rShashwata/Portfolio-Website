---
import Layout from '../../layouts/Layout.astro';
import CaseHead from '../../components/CaseHead.astro';
import { projects, profile } from '../../data/site.js';

// One detail "post" per project, with a link to the next one. The "next" chain
// still walks the full list, so a bespoke project stays in the loop — its URL
// exists either way.
export function getStaticPaths() {
  // Projects that own a hand-built page under src/pages/work/ must be skipped
  // here, or Astro renders the same URL twice and the static file silently
  // overwrites this template's output at build time. Declared inside the
  // function because Astro hoists getStaticPaths out of the frontmatter scope —
  // a module-level const is not in scope by the time it runs.
  const bespoke = ['uae-india-start-up-series'];
  return projects
    .map((p, i) => ({
      params: { id: p.id },
      props: { project: p, next: projects[(i + 1) % projects.length] },
    }))
    .filter((route) => !bespoke.includes(route.params.id));
}

const { project, next } = Astro.props;
// Real case-study media if the project provides a `gallery` array, otherwise
// fall back to 4 placeholder tiles. An item is either a plain string (image
// path or external URL) or an object with a `type` — see site.js for the
// full list. One loose shape rather than a union: site.js is plain JS, so
// `type` widens to string and a discriminated union won't narrow from it.
type MediaItem = {
  type: string;
  id?: string;
  src?: string;
  poster?: string;
  vertical?: boolean;
  label?: string;
  meta?: string;
  cover?: string;
};
type GalleryItem = string | MediaItem;
const galleryItems: GalleryItem[] | null =
  Array.isArray(project.gallery) && project.gallery.length ? project.gallery : null;
const isMedia = (item: GalleryItem): item is MediaItem =>
  typeof item === 'object' && item !== null;
// 'image' | 'youtube' | 'video' | 'pdf' | 'doc'
const kindOf = (item: GalleryItem) => (isMedia(item) ? item.type : 'image');
// Players (YouTube or self-hosted) are 16:9 unless flagged vertical (9:16).
const isPlayer = (item: GalleryItem) =>
  kindOf(item) === 'youtube' || kindOf(item) === 'video';
const isVertical = (item: GalleryItem) => isMedia(item) && item.vertical === true;
// Badge for a `doc` tile: the file extension, or DOC if the URL has none.
const docExt = (src = '') => {
  const match = src.split(/[?#]/)[0].match(/\.([a-z0-9]{2,5})$/i);
  return match ? match[1].toUpperCase() : 'DOC';
};
// Fall back to a readable filename when no `label` is given.
const docName = (src = '') => {
  const last = decodeURIComponent(src.split(/[?#]/)[0].split('/').pop() || '');
  return last.replace(/\.[a-z0-9]{2,5}$/i, '') || 'Document';
};
const placeholders = [0, 1, 2, 3];
---

<Layout title={`${project.title} — ${profile.name}`} description={project.description[0]}>
  <CaseHead />

  <main class="post" style={`--a:${project.accent}`}>
    <!-- Title block -->
    <section class="post__intro section">
      <div class="wrap">
        <p class="eyebrow" data-reveal>{project.category}</p>
        <h1 class="display post__title" data-reveal>{project.title}</h1>
        <ul class="post__meta">
          <li data-reveal><span class="post__meta-k">Client</span>{project.client}</li>
          <li data-reveal><span class="post__meta-k">Role</span>{project.role}</li>
          <li data-reveal><span class="post__meta-k">Year</span>{project.year}</li>
          <li data-reveal>
            <span class="post__meta-k">Services</span>{project.services.join(', ')}
          </li>
        </ul>
      </div>
    </section>

    <!-- Featured media -->
    <div class="wrap">
      <figure class="post__hero" data-reveal>
        {
          project.media ? (
            <img src={project.media} alt={project.title} />
          ) : (
            <span class="post__hero-label">{project.title}</span>
          )
        }
      </figure>
    </div>

    <!-- Description -->
    <section class="post__body section">
      <div class="wrap post__body-grid">
        <h2 class="display post__body-title" data-reveal>Overview</h2>
        <div class="post__copy">
          {project.description.map((para) => <p data-reveal>{para}</p>)}
        </div>
      </div>
    </section>

    <!-- Gallery -->
    <section class="post__gallery section">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Gallery</p>
        <div class="post__grid">
          {
            galleryItems
              ? galleryItems.map((item, i) => (
                  <figure
                    class:list={[
                      'post__tile',
                      {
                        // Exactly one layout treatment per item, so the
                        // modifiers never compete on specificity.
                        'post__tile--wide': i === 0 && kindOf(item) === 'image',
                        'post__tile--video': isPlayer(item) && !isVertical(item),
                        'post__tile--video-portrait': isPlayer(item) && isVertical(item),
                        'post__tile--doc': kindOf(item) === 'pdf',
                        'post__tile--link': kindOf(item) === 'doc',
                        'post__tile--cover': kindOf(item) === 'doc' && isMedia(item) && !!item.cover,
                      },
                    ]}
                    data-reveal
                  >
                    {!isMedia(item) ? (
                      <img src={item} alt={`${project.title} — image ${i + 1}`} loading="lazy" />
                    ) : item.type === 'youtube' ? (
                      <iframe
                        src={`https://www.youtube-nocookie.com/embed/${item.id}`}
                        title={`${project.title} — video ${i + 1}`}
                        loading="lazy"
                        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen
                      />
                    ) : item.type === 'video' ? (
                      // Self-hosted (R2). No autoplay: playback stays user-initiated,
                      // which also keeps it clear of prefers-reduced-motion.
                      <video
                        src={item.src}
                        poster={item.poster}
                        controls
                        preload="metadata"
                        playsinline
                        aria-label={`${project.title} — video ${i + 1}`}
                      />
                    ) : item.type === 'pdf' ? (
                      <iframe
                        src={item.src}
                        title={`${project.title} — document ${i + 1}`}
                        loading="lazy"
                      />
                    ) : item.type === 'doc' ? (
                      // Link, not an embed: navigation isn't subject to CSP or
                      // the file host's X-Frame-Options, so this works for any
                      // URL anywhere — including hosts we don't allowlist.
                      <a
                        class:list={['post__doc', { 'post__doc--cover': item.cover }]}
                        href={item.src}
                        target="_blank"
                        rel="noopener"
                        data-cursor="Open"
                      >
                        {item.cover && (
                          <img class="post__doc-img" src={item.cover} alt="" loading="lazy" />
                        )}
                        <span class="post__doc-kind">{docExt(item.src)}</span>
                        <span class="post__doc-name">{item.label || docName(item.src)}</span>
                        {item.meta && <span class="post__doc-meta">{item.meta}</span>}
                        <span class="post__doc-cta">View ↗</span>
                      </a>
                    ) : null}
                  </figure>
                ))
              : placeholders.map((g) => (
                  <div class:list={['post__tile', { 'post__tile--wide': g === 0 }]} data-reveal />
                ))
          }
        </div>
      </div>
    </section>

    <!-- Next project -->
    <a class="post__next" href={`/work/${next.id}`} data-cursor="Next" style={`--a:${next.accent}`}>
      <div class="wrap">
        <span class="eyebrow">Next project</span>
        <span class="display post__next-title">{next.title}</span>
        <span class="post__next-cat">{next.category} →</span>
      </div>
    </a>
  </main>
</Layout>

<style>
  .post__intro {
    padding-top: clamp(7rem, 16vh, 11rem);
  }
  .post__title {
    font-size: var(--step-huge);
    margin: 0.2em 0 0.5em;
  }
  .post__meta {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    border-top: 1px solid var(--line);
    padding-top: clamp(1.2rem, 3vh, 2rem);
  }
  .post__meta li {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: var(--step-0);
  }
  .post__meta-k {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-dim);
  }

  .post__hero {
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: radial-gradient(120% 120% at 25% 15%, var(--a), #000 92%);
  }
  .post__hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .post__hero-label {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    color: #000;
    mix-blend-mode: overlay;
    font-size: clamp(2rem, 8vw, 6rem);
  }

  .post__body-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(1.5rem, 5vw, 5rem);
  }
  .post__body-title {
    font-size: var(--step-2);
  }
  .post__copy {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    font-size: var(--step-1);
    line-height: 1.4;
    max-width: 60ch;
  }

  .post__grid {
    margin-top: clamp(1.5rem, 4vh, 2.5rem);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.8rem, 2vw, 1.5rem);
  }
  .post__tile {
    aspect-ratio: 4 / 3;
    border-radius: 6px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--a), #000 95%);
    opacity: 0.85;
    margin: 0;
  }
  .post__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .post__tile--wide {
    grid-column: 1 / -1;
    aspect-ratio: 21 / 9;
  }
  .post__tile :is(iframe, video) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  /* contain, so a clip whose ratio doesn't match the tile is letterboxed
     rather than cropped */
  .post__tile video {
    object-fit: contain;
    background: #000;
  }
  /* Landscape video: always its own full-width row at the player's native
     16:9. Full-width because a 16:9 tile beside a 4:3 image leaves an uneven
     row. Full opacity because a dimmed player reads as disabled. */
  .post__tile--video {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
    opacity: 1;
  }
  /* Vertical video (Shorts/Reels): stays in one column, but the height is
     capped — an unconstrained 9:16 tile at column width computes taller than
     the viewport. The player is centred at its native ratio, tile background
     showing either side. */
  .post__tile--video-portrait {
    --portrait-h: min(78vh, 700px);
    aspect-ratio: auto;
    height: var(--portrait-h);
    display: grid;
    place-items: center;
    opacity: 1;
  }
  /* Both dimensions are stated explicitly rather than left to `width: auto` +
     `aspect-ratio`, which resolved against the column width (not the capped
     height) on wide viewports and overflowed the tile. `min(100%, …)` keeps
     the player inside the column when 9:16 of the height is wider than it. */
  .post__tile--video-portrait :is(iframe, video) {
    height: 100%;
    width: min(100%, calc(var(--portrait-h) * 9 / 16));
  }
  /* PDF: full-width so it is actually readable, height-capped so it doesn't
     run past the viewport. */
  .post__tile--doc {
    grid-column: 1 / -1;
    aspect-ratio: auto;
    height: min(85vh, 900px);
    opacity: 1;
  }

  /* Document link tile — keeps the normal 4:3 grid rhythm. */
  .post__tile--link {
    opacity: 1;
  }
  /* With a cover page: A4 (210:297) at a capped height, same approach as the
     vertical video tile — both dimensions stated so nothing overflows. */
  .post__tile--cover {
    --cover-h: min(78vh, 720px);
    /* A4 by default so narrow columns wrap the page exactly; the cap stops it
       running past the viewport once the column gets wide. */
    aspect-ratio: 210 / 297;
    max-height: var(--cover-h);
  }
  .post__doc--cover {
    position: relative;
    padding: 0;
    justify-content: flex-end;
  }
  /* Scoped through the tile class so it outranks `.post__tile img`, which
     otherwise forces width:100% and object-fit:cover and crops the page. */
  .post__tile--cover .post__doc-img {
    position: absolute;
    inset: 0;
    margin: auto;
    width: min(100%, calc(var(--cover-h) * 210 / 297));
    height: 100%;
    /* contain, never cover — cropping a cover page cuts off its title */
    object-fit: contain;
  }
  /* Scrim so the caption stays legible over any cover artwork. */
  .post__doc--cover::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 60%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9), rgba(0, 0, 0, 0));
    pointer-events: none;
    z-index: 1;
  }
  .post__doc--cover > span {
    position: relative;
    z-index: 2;
    margin-inline: clamp(1.2rem, 3vw, 2rem);
  }
  /* The scrim only backs the caption, so the badge needs its own plate —
     cover artwork is often pale up top and the outline alone disappears. */
  .post__doc--cover > .post__doc-kind {
    position: absolute;
    top: clamp(1.2rem, 3vw, 2rem);
    left: 0;
    background: rgba(0, 0, 0, 0.55);
    border-color: rgba(244, 240, 230, 0.35);
    opacity: 1;
  }
  .post__doc--cover > .post__doc-cta {
    margin-bottom: clamp(1.2rem, 3vw, 2rem);
  }
  .post__doc {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    width: 100%;
    height: 100%;
    padding: clamp(1.2rem, 3vw, 2rem);
    /* The tile sits on an accent→black gradient in BOTH themes, so this is
       deliberately not var(--fg) — that flips to near-black on light and
       leaves dark text on a dark tile. */
    color: #f4f0e6;
    text-decoration: none;
  }
  .post__doc-kind {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25em 0.6em;
    border: 1px solid currentColor;
    border-radius: 100px;
    opacity: 0.85;
  }
  .post__doc-name {
    margin-top: auto;
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.05;
    font-size: clamp(1.1rem, 2.2vw, 1.9rem);
  }
  .post__doc-meta {
    font-size: var(--step--1);
    opacity: 0.7;
  }
  .post__doc-cta {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: transform 0.4s var(--ease);
  }
  .post__tile--link:hover .post__doc-cta {
    transform: translateX(4px);
  }

  .post__next {
    display: block;
    border-top: 1px solid var(--line);
    padding: clamp(3rem, 10vh, 7rem) 0;
    background: var(--bg-soft);
    transition: background 0.5s var(--ease);
  }
  .post__next:hover {
    background: var(--a);
  }
  .post__next .wrap {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-inline: var(--pad);
  }
  .post__next-title {
    font-size: var(--step-2);
    transition: color 0.4s var(--ease);
  }
  .post__next:hover .post__next-title,
  .post__next:hover .eyebrow,
  .post__next:hover .post__next-cat {
    color: #000;
  }
  .post__next-cat {
    font-size: var(--step-0);
    color: var(--fg-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  @media (max-width: 820px) {
    .post__meta {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem 1rem;
    }
    .post__body-grid {
      grid-template-columns: 1fr;
    }
    .post__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
