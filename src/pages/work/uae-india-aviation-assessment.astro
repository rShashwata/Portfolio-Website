---
// ───────────────────────────────────────────────────────────────────────────
//  BESPOKE CASE STUDY — UAE-India Aviation Assessment
//  Hand-built page, deliberately NOT rendered by work/[id].astro. That
//  template skips this slug (see its `bespoke` list) so only this file owns
//  the URL. The project still lives in site.js: it drives the home-page row,
//  the gallery card and the "next project" chain, and the hero meta below is
//  read from it rather than duplicated here. Same shape as the UISS bespoke
//  page — hero markup and the paged-viewer mechanics are copied from there
//  on purpose, so the two hand-built case studies read as one family.
//
//  Two segments, one PDF each, both rendered page-by-page to JPGs with
//  tools/pdf-pages.py (not wired into `npm run covers` — see that script's
//  own header) into public/img/work/<id>/<segment>/page-NN.jpg. Re-run it by
//  hand if either report is ever revised:
//    tools/.venv/Scripts/python.exe tools/pdf-pages.py <pdf> <out-dir> page
//
//  The paged viewer (data-guide-viewer/-page/-prev/-next/-count) is generic —
//  initGuidelinesViewer() in main.js wires up every instance on the page, so
//  nothing here is UISS-specific.
// ───────────────────────────────────────────────────────────────────────────
import Layout from '../../layouts/Layout.astro';
import CaseHead from '../../components/CaseHead.astro';
import { projects, profile } from '../../data/site.js';

const ID = 'uae-india-aviation-assessment';
const index = projects.findIndex((p) => p.id === ID);
const project = projects[index];
const next = projects[(index + 1) % projects.length];

// ── EDIT BELOW ────────────────────────────────────────────────────────────

const lede = [
  'Two publications for the same client relationship, at two different paces. One is a one-off briefing paper, compiled once for a specific round of outreach. The other is a monthly report, re-populated with new data every cycle rather than redesigned from scratch. Different rhythms, but built on one shared system — a grid, a chart language and a card format that holds regardless of which numbers land in it next.',
];

// Both PDFs render at the same page ratio (A4 portrait) and the same pixel
// size (tools/pdf-pages.py's fixed 1600px render width), so one aspect value
// and one set of intrinsic dimensions covers both viewers.
const PAGE_ASPECT = '1600 / 2263';
const PAGE_W = 1600;
const PAGE_H = 2263;

type Segment = {
  no: string;
  eyebrow: string;
  title: string;
  body: string[];
  pages: string[];
  // 1-indexed page numbers that must render alone even where the sequential
  // pairing below would otherwise pair them — e.g. a section-divider page
  // that has to stand alone because its facing page was pulled from the
  // final layout.
  forceSingle?: number[];
};

// Both source documents were laid out to be printed as booklets: a front
// cover on its own, interior pages that open as spreads, a back cover on its
// own. `paginate` reconstructs that — the first and last page always stand
// alone, everything between pairs up sequentially, skipping over any
// `forceSingle` page (and re-pairing cleanly from the page after it). When a
// run between forced breaks is an odd length, the last unpaired page before
// the next break is left single rather than forced into a mismatched pair —
// there's no real second half to show it next to.
type PageUnit = { srcs: string[]; label: string };
function paginate(pages: string[], forceSingle: number[] = []): PageUnit[] {
  const n = pages.length;
  if (n <= 2) return pages.map((src, i) => ({ srcs: [src], label: `page ${i + 1}` }));

  const forced = new Set(forceSingle.map((p) => p - 1));
  const units: PageUnit[] = [{ srcs: [pages[0]], label: 'page 1' }];
  const last = n - 1;
  let i = 1;
  while (i < last) {
    const pairable = i + 1 < last && !forced.has(i) && !forced.has(i + 1);
    if (pairable) {
      units.push({ srcs: [pages[i], pages[i + 1]], label: `pages ${i + 1}-${i + 2}` });
      i += 2;
    } else {
      units.push({ srcs: [pages[i]], label: `page ${i + 1}` });
      i += 1;
    }
  }
  units.push({ srcs: [pages[last]], label: `page ${n}` });
  return units;
}

// One page-unit list per breakpoint, not one CSS-hidden layout doing double
// duty: on a phone-width column, half of a spread renders too small to read,
// so mobile pages through every image individually instead (see the
// `avi__guide-viewer--simple` / `--spread` split below).
function simplePaginate(pages: string[]): PageUnit[] {
  return pages.map((src, i) => ({ srcs: [src], label: `page ${i + 1}` }));
}

const dialogue: Segment = {
  no: '01',
  eyebrow: 'Paper 01',
  title: 'UAE-India Aviation Dialogue: Engaging with Indian Parliamentarians',
  body: [
    'A briefing paper for the Embassy’s aviation dialogue: which Indian MPs have already put aviation on the record — a resolution, a question, a floor speech — and are therefore the right people for HE Abdulnasser Alshaali, PhD, the UAE Ambassador to India, to meet next. Fifteen pages, structured to be scanned rather than read start to finish: an objective and a rationale, then every relevant MP split across the Lok Sabha and Rajya Sabha, each on one card with their constituency, party and the specific intervention that got them on the list — a fare-hike resolution, a Point-of-Call request, an MRO-hub push.',
    'It closes on a shortlist: a handful of names pulled back out of the full directory, each annotated with the political weight and the specific aviation angle that makes them worth prioritising first — from a four-term MP chairing the Parliamentary Standing Committee on External Affairs to a first-term MP whose resolution on Gulf airfares had already moved the government to act.',
    'The design problem was density: thirty-plus near-identical profile blocks that still needed to read as a directory, not a wall of text. One repeating card format, grouped by chamber, so a reader can jump straight to Lok Sabha or Rajya Sabha and scan by state or party without re-reading the whole document.',
  ],
  pages: Array.from(
    { length: 15 },
    (_, i) => `/img/work/${ID}/parliamentary-dialogue/page-${String(i + 1).padStart(2, '0')}.jpg`
  ),
  // Page 8 is the "Rajya Sabha" section divider. Its facing page was pulled
  // from the final layout, so in the printed booklet it stands alone rather
  // than opening as a spread with page 9 — pairing resumes cleanly at 9-10.
  forceSingle: [8],
};

const marketReport: Segment = {
  no: '02',
  eyebrow: 'Paper 02 - Monthly Edition',
  title: 'UAE-India Market Intelligence Report',
  body: [
    'A monthly report, re-issued and re-populated with fresh data every cycle. This edition — January 2026 — reads 1,240 weekly one-way flights and over 1.18 million monthly one-way seats across the UAE-India corridor: an Executive Summary, then capacity utilisation, carrier- and emirate-wise market share, route-level competitive analysis on the corridor’s two busiest city pairs, and a connectivity-gap case study on cities the market doesn’t serve yet.',
    'The structure repeats every month — the same table of contents, the same stat-card and comparison-chart language — but the numbers behind it are entirely new each time: Emirates’ 22.66% share this edition, Dubai’s 49.18% of total capacity, Vadodara flagged as the strongest case for a first direct UAE route. The system had to hold that turnover without the layout ever looking rebuilt.',
  ],
  pages: Array.from(
    { length: 20 },
    (_, i) => `/img/work/${ID}/market-intelligence-report/page-${String(i + 1).padStart(2, '0')}.jpg`
  ),
};

// Paging arrows — identical construction to the UISS viewer's, so both
// bespoke pages share one visual language for this control.
const arrow = (d: string) =>
  `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;
const ARROW_PREV = arrow('M15 5 9 12l6 7');
const ARROW_NEXT = arrow('M9 5l6 7-6 7');

const metaDescription =
  'Editorial and information design for the UAE Embassy in New Delhi: a parliamentary aviation-dialogue briefing and a monthly UAE-India market-intelligence report.';
---

<Layout title={`${project.title} — ${profile.name}`} description={metaDescription}>
  <CaseHead />

  <main class="avi" style={`--a:${project.accent}`}>
    <!-- ── Hero: full-bleed cover, meta overlaid — same shape as UISS ────── -->
    <section class="hero-avi">
      {
        project.media ? (
          <img class="hero-avi__img" src={project.media} alt="" fetchpriority="high" />
        ) : null
      }
      <div class="hero-avi__inner">
        <div class="wrap">
          <p class="hero-avi__eyebrow" data-reveal>{project.category}</p>
          <h1 class="display hero-avi__title" data-reveal>{project.title}</h1>
          <ul class="hero-avi__meta">
            <li data-reveal><span class="hero-avi__k">Client</span>{project.client}</li>
            <li data-reveal><span class="hero-avi__k">Year</span>{project.year}</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ── Lede ────────────────────────────────────────────────────────── -->
    <section class="section avi__lede">
      <div class="wrap avi__lede-grid">
        <h2 class="display avi__lede-title" data-reveal>Overview</h2>
        <div class="avi__lede-copy">
          {lede.map((para) => <p data-reveal>{para}</p>)}
        </div>
      </div>
    </section>

    <!-- ── Two segments, text-left / paged-frame-right, in reading order ── -->
    <section class="section avi__segments">
      <div class="wrap">
        {
          [dialogue, marketReport].map((seg) => {
            const spreadUnits = paginate(seg.pages, seg.forceSingle);
            const simpleUnits = simplePaginate(seg.pages);
            const viewers: { units: PageUnit[]; variant: string }[] = [
              { units: spreadUnits, variant: 'spread' },
              { units: simpleUnits, variant: 'simple' },
            ];
            return (
              <div class="avi__guides" data-reveal>
                <div class="avi__guides-head">
                  <div class="avi__guides-text">
                    <p class="eyebrow">{seg.eyebrow}</p>
                    <h3 class="display avi__guides-title">{seg.title}</h3>
                    <div class="avi__guides-copy">
                      {seg.body.map((para) => (
                        <p>{para}</p>
                      ))}
                    </div>
                  </div>

                  <div class="avi__guide-viewers">
                    {viewers.map(({ units, variant }) => (
                      <figure
                        class:list={['avi__guide-viewer', `avi__guide-viewer--${variant}`]}
                        data-guide-viewer
                        data-guide-protect
                        style={`--ar:${PAGE_ASPECT}`}
                      >
                        <div class="avi__guide-frame">
                          {units.map((unit, i) => (
                            <div
                              class:list={['avi__guide-page', { 'is-active': i === 0 }]}
                              data-guide-page
                            >
                              {unit.srcs.map((src) => (
                                <img
                                  class="avi__guide-img"
                                  src={src}
                                  width={PAGE_W}
                                  height={PAGE_H}
                                  alt={`${seg.title} — ${unit.label} of ${seg.pages.length}`}
                                  loading="lazy"
                                />
                              ))}
                            </div>
                          ))}
                        </div>
                        <div class="avi__guide-controls">
                          <button
                            type="button"
                            class="avi__guide-btn"
                            data-guide-prev
                            aria-label="Previous page"
                            disabled
                            set:html={ARROW_PREV}
                          />
                          <span class="avi__guide-count" data-guide-count>{`1 / ${units.length}`}</span>
                          <button
                            type="button"
                            class="avi__guide-btn"
                            data-guide-next
                            aria-label="Next page"
                            set:html={ARROW_NEXT}
                          />
                        </div>
                      </figure>
                    ))}
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- ── Next project ────────────────────────────────────────────────── -->
    <a class="avi__next" href={`/work/${next.id}`} data-cursor="Next" style={`--a:${next.accent}`}>
      <div class="wrap">
        <span class="eyebrow">Next project</span>
        <span class="display avi__next-title">{next.title}</span>
        <span class="avi__next-cat">{next.category} →</span>
      </div>
    </a>
  </main>
</Layout>

<style>
  /* ── Shared header over this page's dark hero — identical rationale to the
     UISS page's copy of this block: the fixed header sits on artwork instead
     of --bg here, so its ink needs a fixed light value rather than the theme
     token. :global() because the header is a separate component. */
  :global(.post-head:not(.is-scrolled)),
  :global(.post-head:not(.is-scrolled) .post-head__brand),
  :global(.post-head:not(.is-scrolled) .post-head__right) {
    color: #f4f0e6;
  }
  :global([data-theme='light'] .post-head.is-scrolled) {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
  }

  /* ── Page tokens ────────────────────────────────────────────────────── */
  .avi {
    --r: 8px;
    --pill: 999px;
    --stack: clamp(2rem, 5vh, 3.5rem);
    --stack-lg: clamp(3rem, 8vh, 5rem);
    /* Shared editorial grid: label/heading left, content right. */
    --col: 1fr 1.4fr;
    --col-gap: clamp(1.5rem, 5vw, 5rem);
  }

  /* ── Hero ───────────────────────────────────────────────────────────── */
  .hero-avi {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: radial-gradient(120% 120% at 25% 15%, var(--a), #000 92%);
  }
  .hero-avi__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-avi::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.92) 0%,
      rgba(0, 0, 0, 0.6) 38%,
      rgba(0, 0, 0, 0.15) 70%,
      rgba(0, 0, 0, 0.35) 100%
    );
  }
  .hero-avi__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: clamp(7rem, 18vh, 12rem) var(--pad) clamp(2.5rem, 7vh, 5rem);
    color: #f4f0e6;
  }
  .hero-avi__eyebrow {
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(244, 240, 230, 0.72);
  }
  .hero-avi__title {
    font-size: clamp(2.4rem, 6.7vw, 6.6rem);
    margin: 0.18em 0 0.5em;
  }
  .hero-avi__meta {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem clamp(2.5rem, 6vw, 5rem);
    width: 100%;
    border-top: 1px solid rgba(244, 240, 230, 0.28);
    padding-top: clamp(1rem, 2.5vh, 1.5rem);
  }
  .hero-avi__meta li {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: var(--step-0);
  }
  .hero-avi__k {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(244, 240, 230, 0.66);
  }

  /* ── Lede ───────────────────────────────────────────────────────────── */
  .avi__lede-grid {
    display: grid;
    grid-template-columns: var(--col);
    gap: var(--col-gap);
  }
  .avi__lede-title {
    font-size: var(--step-2);
  }
  .avi__lede-copy {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    font-size: var(--step-1);
    line-height: 1.4;
    max-width: 60ch;
  }

  /* ── Segments ───────────────────────────────────────────────────────── */
  /* A little air above the two segment blocks; each block carries its own
     --stack-lg beneath it (below), so the section itself needs no padding
     of its own on that side. */
  .avi__segments {
    padding-top: 0;
  }
  .avi__guides {
    margin-bottom: var(--stack-lg);
  }
  /* The divider: only the second segment onward is ruled, so this reads as
     one line between Segment 01 and Segment 02 — same hairline the home-page
     work rows and the UISS guideline blocks use. */
  .avi__guides + .avi__guides {
    padding-top: var(--stack-lg);
    border-top: 1px solid var(--line);
  }
  .avi__guides-head {
    display: grid;
    grid-template-columns: var(--col);
    align-items: start;
    gap: var(--col-gap);
  }
  .avi__guides-title {
    font-size: var(--step-1);
    margin-top: 0.3em;
  }
  .avi__guides-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
    max-width: 62ch;
    color: var(--fg-dim);
  }

  /* Paged frame — sized by viewport HEIGHT, not by the grid column. Both
     source documents are A4 portrait, so a width-driven frame in the 1.4fr
     column was either an oversized close-up or, capped narrower, left the
     rest of the column empty. Height-driving it instead makes each page as
     large as it can be while still fitting the screen without scrolling to
     read it.
     Two independent viewers live here — `--spread` and `--simple` — only one
     shown at a time (below); this wrapper is the actual grid child so adding
     the second viewer didn't turn `.avi__guides-head` into a 3-column grid. */
  .avi__guide-viewers {
    width: 100%;
    margin-top: calc(var(--step--1) * 0.33);
  }
  .avi__guide-viewer {
    width: 100%;
  }
  /* Desktop/tablet: spread view. Phone width switches this off in favour of
     `--simple` below — half of a spread renders too small to read that
     narrow, and there's no leftover column space to spend on it anyway. */
  .avi__guide-viewer--simple {
    display: none;
  }
  /* One page unit per `data-guide-page`, but a unit can hold ONE image (the
     front cover, the back cover, or a leftover/forced-single odd page) or TWO
     side by side (an interior spread) — both PDFs were laid out to be printed
     as booklets, so this reconstructs that rather than paging strictly one
     image at a time. Frame items stretch (the default) so each page-unit row
     gets a DEFINITE width — the column's — for its images' `max-width` to
     resolve against; `justify-content: center` on the row is what actually
     centres a unit narrower than that, e.g. the single covers. Without the
     stretch, a spread's two height-driven images had no real width ceiling
     and ran past the column edge. */
  .avi__guide-frame {
    display: flex;
    flex-direction: column;
  }
  .avi__guide-page {
    display: flex;
    justify-content: center;
    gap: 4px;
  }
  /* width/height: auto + max-width/max-height, with aspect-ratio set, lets the
     browser pick whichever bound is tighter — the column's width on a narrow
     viewport, the viewport's height on a wide one — while staying proportional.
     The vh cap is short of 100 so the fixed header and the controls row below
     never push the frame off-screen. */
  .avi__guide-img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: min(80vh, 900px);
    aspect-ratio: var(--ar);
    border-radius: var(--r);
    object-fit: cover;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    box-shadow: 0 20px 44px -20px rgba(0, 0, 0, 0.45);
    -webkit-user-drag: none;
    user-select: none;
  }
  /* Every spread-view page — even a lone cover — is capped to one spread
     "slot" (half the row, minus half the gap) rather than the full row.
     Without this, a single page had the whole row's width to grow into and
     rendered at its full max-height, while an actual two-up spread had to
     share that width and came out shorter — the frame visibly changed height
     between the cover and an interior spread. Capping both cases to the same
     slot width keeps every page in this viewer the same height. Scoped to
     `--spread` only: the simple mobile viewer never shows two pages at once,
     so its single images should keep using the full row.
     `flex-basis` (a plain percentage), not `width`, is what actually sets
     that slot — a flex item's main size is otherwise resolved from its
     CONTENT before layout can fall back to `max-width`, and an unloaded
     `<img>` has no content size yet. That's what caused the glitch: the item
     resolved to ~0 width the instant a never-before-seen page went from
     `display:none` to active, then jumped to full size once the image
     decoded. A percentage `flex-basis` resolves against the row's own
     (already definite) width instead, so the slot is correct from the very
     first frame regardless of whether the image has loaded. */
  .avi__guide-viewer--spread .avi__guide-img {
    flex: 0 1 calc(50% - 2px);
    max-width: calc(50% - 2px);
  }
  html.js [data-guide-page]:not(.is-active) {
    display: none;
  }
  .avi__guide-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }
  .avi__guide-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--fg);
    touch-action: manipulation;
    transition: background 0.3s var(--ease), color 0.3s var(--ease),
      border-color 0.3s var(--ease), opacity 0.3s var(--ease);
  }
  .avi__guide-btn:hover:not(:disabled) {
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
  }
  .avi__guide-btn svg {
    display: block;
  }
  .avi__guide-btn:disabled {
    opacity: 0.35;
    pointer-events: none;
  }
  .avi__guide-btn:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 2px;
  }
  .avi__guide-count {
    min-width: 4.5ch;
    text-align: center;
    font-size: var(--step--1);
    color: var(--fg-dim);
  }
  html:not(.js) .avi__guide-controls {
    display: none;
  }

  /* ── Next project ───────────────────────────────────────────────────── */
  .avi__next {
    display: block;
    border-top: 1px solid var(--line);
    padding: clamp(3rem, 10vh, 7rem) 0;
    background: var(--bg-soft);
    transition: background 0.5s var(--ease);
  }
  .avi__next:hover {
    background: var(--a);
  }
  .avi__next:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: -6px;
  }
  .avi__next .wrap {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-inline: var(--pad);
  }
  .avi__next-title {
    font-size: var(--step-2);
    transition: color 0.4s var(--ease);
  }
  .avi__next:hover .avi__next-title,
  .avi__next:hover .eyebrow,
  .avi__next:hover .avi__next-cat {
    color: #000;
  }
  .avi__next-cat {
    font-size: var(--step-0);
    color: var(--fg-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 820px) {
    .avi__lede-grid,
    .avi__guides-head {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }
    .avi__guide-viewers {
      margin-top: var(--stack);
    }
    /* Swap which viewer is live — see the `--simple`/`--spread` comment above
       `.avi__guide-viewers`. */
    .avi__guide-viewer--spread {
      display: none;
    }
    .avi__guide-viewer--simple {
      display: block;
    }
    .avi__guide-img {
      max-height: 62vh;
    }
  }
</style>
